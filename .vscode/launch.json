{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "type": "lldb",
      "request": "launch",
      "name": "Debug unit tests in library 'maf'",
      "cargo": {
        "args": [
          "test",
          "--no-run",
          "--lib",
          "--package=maf"
        ],
        "filter": {
          "name": "maf",
          "kind": "lib"
        }
      },
      "args": [],
      "cwd": "${workspaceFolder}"
    },
    {
      "type": "lldb",
      "request": "launch",
      "name": "Debug executable 'maf_platform_host'",
      "cargo": {
        "args": [
          "build",
          "--bin=maf_platform_host",
          "--package=maf_platform_host"
        ],
        "filter": {
          "name": "maf_platform_host",
          "kind": "bin"
        }
      },
      "args": [],
      "env": {
        "RUST_LOG": "maf_platform_host=trace"
      },
      "cwd": "${workspaceFolder}"
    }
  ]
}