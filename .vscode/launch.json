  "version": "0.2.0",
  "configurations": [
    {
      "type": "lldb",
      "request": "launch",
      "name": "Debug executable 'cobbl_container_host'",
      "cargo": {
        "args": [
          "build",
          "--bin=cobble_container_host",
          "--package=cobble_container_host"
        ],
        "filter": {
          "name": "cobble_container_host",
          "kind": "bin"
        }
      },
      "args": [],
      "env": {
        "RUST_LOG": "cobble_container_host=trace"
      },
      "cwd": "${workspaceFolder}"
    }
  ]
}